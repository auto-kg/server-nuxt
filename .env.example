# Public HTTPS host served by Caddy.
NUXT_ALLOWED_HOST=autohub-63-180-133-249.sslip.io
PUBLIC_SITE_URL=https://autohub-63-180-133-249.sslip.io

# Host ports. Caddy should reverse proxy to 127.0.0.1:${NUXT_HOST_PORT}.
NUXT_HOST_PORT=3001
POSTGRES_HOST_PORT=5433

# Postgres container credentials.
POSTGRES_DB=autohub
POSTGRES_USER=autohub
POSTGRES_PASSWORD=change_me_strong_password

# Internal Docker network URL. Keep host=postgres and port=5432.
DATABASE_URL=postgres://autohub:change_me_strong_password@postgres:5432/autohub

# Required for Telegram Mini App initData validation on Nuxt backend.
BOT_TOKEN=123456789:telegram-bot-token
ADMIN_GROUP_ID=-1001234567890

# Optional comma-separated fallback allowlist.
ADMIN_TELEGRAM_IDS=

# Optional. Default is 86400 seconds. Set 0 only for local debugging.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Optional bot notification webhook. Keep empty to disable.
BOT_NOTIFY_URL=http://host.docker.internal:8091/notify/new-car
BOT_NOTIFY_SECRET=change_me_same_as_bot

# Optional for Nuxt dev HMR through the public HTTPS URL.
NUXT_HMR_HOST=

# Upload storage.
STORAGE_DRIVER=local
UPLOADS_DIR=/app/.output/public/uploads
PUBLIC_UPLOADS_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOADS_HOST_DIR=./uploads

# Future S3/R2 settings. Not used while STORAGE_DRIVER=local.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
