DATABASE_URL=postgres://postgres:postgres@localhost:5432/autohub
BOT_TOKEN=123456789:telegram-bot-token
ADMIN_GROUP_ID=-1001234567890

# Optional comma-separated fallback allowlist.
# ADMIN_TELEGRAM_IDS=123456789,987654321

# Optional. Default is 86400 seconds. Set 0 only for local debugging.
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Optional. Use only after Pinggy has already printed the public HTTPS URL.
# Do not require this for the first Nuxt start.
# NUXT_HMR_HOST=example.a.pinggy.link

# Optional fallback if Vite blocks a tunnel host.
# NUXT_ALLOWED_HOST=example.run.pinggy-free.link
